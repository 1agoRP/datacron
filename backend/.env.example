# ─── DATABASE ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:3141592.Datacron@db.zqxyjgvsduypfuisgxgx.supabase.co:5432/postgres

# ─── JWT AUTH ────────────────────────────────────────────────
SECRET_KEY=TROQUE_POR_UM_VALOR_SECRETO_LONGO_E_ALEATORIO
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ─── GMAIL API ───────────────────────────────────────────────
GMAIL_CREDENTIALS_PATH=./credentials.json
GMAIL_TOKEN_PATH=./token.json
GMAIL_USER=datacroncompany@gmail.com
# Tempo em minutos entre cada varredura automática de e-mails
EMAIL_POLL_INTERVAL_MINUTES=5

# ─── PDF STORAGE ─────────────────────────────────────────────
PDF_STORAGE_PATH=./pdfs_storage

# ─── CORS ────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://datacron.com.br

# ─── APP ─────────────────────────────────────────────────────
ENVIRONMENT=development
# Percentual para gerar alerta de variação de valor (0.20 = 20%)
ALERT_VARIATION_THRESHOLD=0.20

# NotebookLM opcional. Use uma conta Google dedicada e guarde o JSON como segredo.
NOTEBOOKLM_ENABLED=false
NOTEBOOKLM_AUTH_JSON=
NOTEBOOKLM_STORAGE_PATH=
NOTEBOOKLM_WORKER_INTERVAL_MINUTES=10
NOTEBOOKLM_MAX_ATTEMPTS=3
