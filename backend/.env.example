# Database
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/datacron

# Auth
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_WITH_64_HEX_CHARS_MINIMUM
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=2880

# Gmail / IMAP
GMAIL_USER=
GMAIL_PASSWORD=
EMAIL_POLL_INTERVAL_MINUTES=5

# Storage
PDF_STORAGE_PATH=./pdfs_storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=condo-documents

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# App
ENVIRONMENT=development
ALERT_VARIATION_THRESHOLD=0.20

# Webhooks
N8N_WEBHOOK_URL=
OUTBOUND_EMAIL_WEBHOOK_URL=
OUTBOUND_EMAIL_WEBHOOK_SECRET=
ERROR_WEBHOOK_URL=
INBOUND_WEBHOOK_SECRET=
CRON_SECRET=

# NotebookLM optional
NOTEBOOKLM_ENABLED=false
NOTEBOOKLM_AUTH_JSON=
NOTEBOOKLM_STORAGE_PATH=
NOTEBOOKLM_WORKER_INTERVAL_MINUTES=10
NOTEBOOKLM_MAX_ATTEMPTS=3
