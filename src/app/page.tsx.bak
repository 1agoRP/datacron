                <a className="text-slate-700 dark:text-slate-300 text-sm font-medium hover:text-blue-600 transition-colors" href="#showcase">Dashboard</a>
              </nav>
              <div className="flex gap-3">
                <button 
                  onClick={() => setIsLoginView(true)}
                  className="flex min-w-[84px] cursor-pointer items-center justify-center rounded-lg h-10 px-6 bg-blue-600 text-white text-sm font-bold hover:bg-blue-700 transition-colors"
                >
                  Acessar Sistema
                </button>
              </div>
            </div>
          </header>

          <main className="flex flex-col">
            
            <section className="px-6 md:px-20 py-12 md:py-24">
