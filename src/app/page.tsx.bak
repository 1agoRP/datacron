                    </label>
                  </div>
                  <button 
                    type="submit" 
                    className="w-full h-12 mt-4 bg-blue-600 text-white rounded-lg font-bold shadow-lg shadow-blue-600/20 hover:bg-blue-700 active:scale-[0.98] transition-all flex items-center justify-center"
                    disabled={isLoading}
                  >
                    {isLoading ? 'Autenticando...' : 'Entrar no Sistema'}
                  </button>
                </form>
              </div>
              <div className="bg-slate-50 dark:bg-slate-900/50 p-4 border-t border-slate-200 dark:border-slate-700 flex items-center justify-center gap-2 text-xs text-slate-500">
                <Fingerprint size={14} />
                <p>Acesso Restrito - Monitorado Ativamente</p>
              </div>
            </motion.div>
          </motion.div>
        )}
      </AnimatePresence>
    </div>
  );
}
