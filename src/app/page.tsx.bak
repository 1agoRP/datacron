'use client';

import { useState, FormEvent } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import { 
  Building2, 
  ShieldCheck, 
  Mail, 
  ArrowRight, 
  ChevronRight,
  TrendingUp,
  Fingerprint,
  Layers,
  Sparkles,
  AlertTriangle,
  X,
  CheckCircle2,
